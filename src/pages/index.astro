---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import FeaturedProducts from "../components/sections/FeaturedProducts.astro";
import FeaturedProjects from "../components/sections/FeaturedProjects.astro";
import FeaturedServices from "../components/sections/FeaturedServices.astro";
import MisionVision from "../components/sections/MisionVision.astro";
import CTA from "../components/sections/CTA.astro";
---

<Layout
  title="Vinílicos JJ - Pisos de Vinilo de Alta Calidad"
  description="Especialistas en instalación de pisos de vinilo. Calidad, durabilidad y diseño para tu hogar o negocio."
  keywords="pisos de vinilo, vinílicos, instalación de pisos, pisos laminados, pisos resistentes"
>
  <Header />

  <main id="main-content" role="main">
    <Hero />
    <About />
    <MisionVision />
    <FeaturedProducts />
    <FeaturedServices />
    <FeaturedProjects />
  </main>

  <CTA />
  <Footer />
</Layout>
