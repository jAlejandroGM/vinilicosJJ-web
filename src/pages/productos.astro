---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CTA from "../components/sections/CTA.astro";
import { productCategories } from "../data/products";

const whatsappNumber = "51987654321"; // +51 987 654 321
---

<Layout
  title="Productos - Vinílicos JJ"
  description="Explora nuestro catálogo completo de pisos vinílicos, pegamentos, accesorios y zócalos. Soluciones de alta calidad para cada necesidad."
  keywords="pisos vinílicos, SPC click, conductivo antiestático, homogéneo antibacterial, pegamentos, zócalos, accesorios"
>
  <Header />

  <!-- Hero Section -->
  <section class="bg-linear-to-br from-amber-50 to-stone-50 py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span
          class="inline-block px-4 py-2 bg-amber-800 text-white text-sm font-semibold rounded-full mb-6"
        >
          Catálogo Completo
        </span>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          Nuestros Productos
        </h1>
        <p class="text-lg md:text-xl text-gray-700 leading-relaxed">
          Descubre nuestra amplia gama de productos especializados para
          instalación de pisos vinílicos. Calidad profesional garantizada.
        </p>
      </div>
    </div>
  </section>

  <!-- Categorías de Productos -->
  {
    productCategories.map((category, categoryIndex) => {
      return (
        <section
          class={`py-16 md:py-20 ${categoryIndex % 2 === 0 ? "bg-white" : "bg-stone-50"}`}
          id={category.slug}
        >
          <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            {/* Encabezado de Categoría */}
            <div class="max-w-3xl mx-auto text-center mb-12">
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
                {category.name}
              </h2>
              <p class="text-xl text-amber-800 font-semibold">
                {category.description}
              </p>
            </div>

            {/* Grid de Subproductos */}
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {category.subProducts.map((product) => (
                <article class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-stone-100">
                  {/* Imagen placeholder */}
                  <div class="relative h-48 bg-linear-to-br from-stone-100 to-stone-200">
                    <div class="absolute inset-0 flex items-center justify-center">
                      <svg
                        class="w-16 h-16 text-stone-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.5"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                      </svg>
                    </div>
                  </div>

                  {/* Contenido */}
                  <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-3">
                      {product.name}
                    </h3>
                    <p class="text-gray-600 leading-relaxed mb-4 line-clamp-3">
                      {product.shortDescription}
                    </p>

                    {/* Características principales (primeras 3) */}
                    {product.features.length > 0 && (
                      <ul class="space-y-2 mb-6">
                        {product.features.slice(0, 3).map((feature) => (
                          <li class="flex items-start gap-2 text-sm text-gray-700">
                            <svg
                              class="w-5 h-5 text-amber-800 shrink-0 mt-0.5"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"
                              />
                            </svg>
                            <span>{feature.name}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {/* Botones */}
                    <div class="flex flex-col gap-3">
                      <a
                        href={`/productos/${category.slug}/${product.slug}`}
                        class="inline-flex items-center justify-center w-full px-6 py-3 text-base font-semibold text-white bg-amber-800 rounded-lg hover:bg-amber-900 transition-colors"
                      >
                        Ver detalles completos
                        <svg
                          class="w-5 h-5 ml-2"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 7l5 5m0 0l-5 5m5-5H6"
                          />
                        </svg>
                      </a>

                      <a
                        href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hola, estoy interesado en ${product.name}. ¿Podrían brindarme más información?`)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center w-full px-6 py-3 text-base font-semibold text-amber-800 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors"
                      >
                        <svg
                          class="w-5 h-5 mr-2"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                        </svg>
                        Consultar por WhatsApp
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })
  }

  <CTA />
  <Footer />
</Layout>
