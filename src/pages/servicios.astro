---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import FeatureItem from "../components/ui/FeatureItem.astro";
import CTA from "../components/sections/CTA.astro";
import { services } from "../data/services";

const whatsappNumber = "51987654321"; // +51 987 654 321
---

<Layout
  title="Servicios - Vinílicos JJ"
  description="Descubre nuestros servicios profesionales: instalación certificada, asesoría personalizada, mantenimiento especializado y entrega rápida. Soluciones integrales para tu proyecto de pisos."
  keywords="instalación pisos vinílicos, asesoría pisos, mantenimiento pisos, entrega rápida, servicios profesionales"
>
  <Header />

  <!-- Hero Section -->
  <section class="bg-linear-to-br from-amber-50 to-stone-50 py-16 md:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span
          class="inline-block px-4 py-2 bg-amber-800 text-white text-sm font-semibold rounded-full mb-6"
        >
          Nuestros Servicios
        </span>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6"
        >
          Soluciones Integrales para Tu Proyecto
        </h1>
        <p class="text-lg md:text-xl text-gray-700 leading-relaxed">
          Te acompañamos en cada etapa de tu proyecto: desde la asesoría inicial
          hasta la instalación y mantenimiento. Nuestro compromiso es tu
          satisfacción total.
        </p>
      </div>
    </div>
  </section>

  <!-- Servicios Grid -->
  <section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <div class="divide-y divide-stone-200">
        {
          services.map((service, index) => {
            const whatsappMessage = `¡Hola Vinílicos J&J! 👋

Estoy interesado en conocer más sobre su servicio de *${service.title}*.

¿Podrían brindarme información detallada y cotización?

Gracias.`;
            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

            return (
              <article
                id={service.id}
                class="py-12 md:py-16 first:pt-0 last:pb-0"
              >
                <div
                  class={`grid md:grid-cols-2 gap-8 lg:gap-16 items-center ${
                    index % 2 === 1 ? "" : ""
                  }`}
                >
                  {/* Contenido */}
                  <div class={index % 2 === 1 ? "md:order-2" : ""}>
                    <span class="text-6xl font-bold text-stone-400">
                      0{index + 1}
                    </span>
                    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                      {service.title}
                    </h2>
                    <p class="text-lg text-gray-700 mb-8 leading-relaxed">
                      {service.description}
                    </p>

                    {/* CTA */}
                    <a
                      href={whatsappUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-6 py-3 bg-amber-800 text-white font-semibold rounded-lg shadow-md hover:bg-amber-900 hover:shadow-lg hover:scale-105 transition-all"
                    >
                      Solicitar este servicio
                      <svg
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 7l5 5m0 0l-5 5m5-5H6"
                        />
                      </svg>
                    </a>
                  </div>

                  {/* Beneficios - Flip Card */}
                  <div class={index % 2 === 1 ? "md:order-1" : ""}>
                    <div
                      class="flip-card cursor-pointer"
                      data-service-id={service.id}
                    >
                      <div class="flip-card-inner relative w-full min-h-[350px]">
                        {/* Front - Beneficios */}
                        <div class="flip-card-front absolute inset-0 bg-white rounded-2xl p-8 shadow-md border-2 border-amber-800/10 hover:border-amber-800/30 transition-colors">
                          <h3 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                            ¿Qué Incluye?
                          </h3>
                          <div class="space-y-4">
                            {service.benefits.map((benefit) => (
                              <FeatureItem
                                icon="M5 13l4 4L19 7"
                                title={benefit.title}
                                description={benefit.description}
                                size="sm"
                              />
                            ))}
                          </div>
                          <div class="absolute bottom-6 right-6">
                            <svg
                              class="w-6 h-6 text-amber-800/30"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5h-4m4 0v-4m0 4l-5-5"
                              />
                            </svg>
                          </div>
                        </div>

                        {/* Back - Imagen */}
                        <div class="flip-card-back absolute inset-0 bg-white rounded-2xl shadow-md border-2 border-amber-800/10 overflow-hidden">
                          <img
                            src={service.image}
                            alt={service.title}
                            class="w-full h-full object-cover object-center"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <CTA />
  <Footer />
</Layout>

<style>
  .flip-card {
    perspective: 1000px;
  }

  .flip-card-inner {
    transition: transform 0.6s;
    transform-style: preserve-3d;
  }

  .flip-card.flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const flipCards = document.querySelectorAll(".flip-card");

    flipCards.forEach((card) => {
      card.addEventListener("click", () => {
        card.classList.toggle("flipped");
      });
    });
  });
</script>
