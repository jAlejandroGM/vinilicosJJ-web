---
interface Props {
  icon: string;
  title: string;
  description?: string;
  size?: "sm" | "md";
}

const { icon, title, description, size = "md" } = Astro.props;

const containerClasses = size === "sm" ? "gap-3" : "gap-3";
const iconBoxClasses = size === "sm" ? "w-10 h-10" : "w-10 h-10";
const iconClasses = size === "sm" ? "w-5 h-5" : "w-5 h-5";
const titleClasses = size === "sm" ? "text-sm" : "text-sm";
const descClasses = size === "sm" ? "text-xs" : "text-xs";
---

<div class={`flex items-center ${containerClasses}`}>
  <div
    class={`${iconBoxClasses} bg-amber-800 rounded-lg flex items-center justify-center shrink-0`}
  >
    <svg
      class={`${iconClasses} text-white`}
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d={icon}></path>
    </svg>
  </div>
  <div>
    <h3 class={`font-semibold text-gray-900 ${titleClasses}`}>
      {title}
    </h3>
    {
      description && (
        <p class={`text-gray-600 mt-0.5 ${descClasses}`}>{description}</p>
      )
    }
  </div>
</div>
