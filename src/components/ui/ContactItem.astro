---
interface Props {
  icon: "phone" | "location" | "email" | "clock";
  label: string;
  value: string;
  href: string;
}

const { icon, label, value, href } = Astro.props;

// Determinar si es clickeable (no es solo un anchor vacío)
const isClickable = href && href !== "#";

const iconPaths = {
  phone:
    "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  location:
    "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z",
  email:
    "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  clock: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
};
---

{
  isClickable ? (
    <a
      href={href}
      class="flex items-start gap-3 p-3 rounded-lg hover:bg-stone-800 transition-colors group"
    >
      <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-amber-900/20 group-hover:bg-amber-800 transition-colors shrink-0">
        <svg
          class="w-5 h-5 text-amber-600 group-hover:text-white transition-colors"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d={iconPaths[icon]}
          />
        </svg>
      </div>
      <div class="min-w-0">
        <span class="block text-xs text-stone-500 mb-0.5">{label}</span>
        <span class="block text-sm font-medium text-stone-200 group-hover:text-white transition-colors">
          {value}
        </span>
      </div>
    </a>
  ) : (
    <div class="flex items-start gap-3 p-3 rounded-lg">
      <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-amber-900/20 shrink-0">
        <svg
          class="w-5 h-5 text-amber-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d={iconPaths[icon]}
          />
        </svg>
      </div>
      <div class="min-w-0">
        <span class="block text-xs text-stone-500 mb-0.5">{label}</span>
        <span class="block text-sm font-medium text-stone-200">{value}</span>
      </div>
    </div>
  )
}
