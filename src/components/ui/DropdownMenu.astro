---
export interface DropdownItem {
  label: string;
  href: string;
  description?: string;
  icon?: string;
  subItems?: DropdownItem[];
}

interface Props {
  label: string;
  items: DropdownItem[];
  isActive?: boolean;
  headerLink?: {
    label: string;
    href: string;
  };
}

const { label, items, isActive = false, headerLink } = Astro.props;
---

<div class="relative group">
  <!-- Trigger Button -->
  <button
    type="button"
    class={`inline-flex items-center gap-1 px-4 py-2 rounded-lg font-medium transition-colors ${
      isActive
        ? "bg-amber-800 text-white"
        : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
    }`}
    aria-haspopup="true"
    aria-expanded="false"
  >
    {label}
    <svg
      class="w-4 h-4 transition-transform group-hover:rotate-180"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    class="absolute top-full left-0 mt-2 w-80 bg-white rounded-xl shadow-xl border border-stone-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
    role="menu"
    aria-orientation="vertical"
  >
    <div class="py-2">
      {/* Header Link (opcional) */}
      {
        headerLink && (
          <a
            href={headerLink.href}
            class="block px-4 py-3 text-amber-800 font-semibold hover:bg-amber-50 transition-colors border-b border-stone-100 mb-2"
            role="menuitem"
          >
            {headerLink.label}
          </a>
        )
      }
      {
        items.map((item) => (
          <div class="relative group/item">
            {/* Main Item - No clickeable */}
            <div class="flex items-start gap-3 px-4 py-3 hover:bg-stone-50 transition-colors cursor-default">
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="font-semibold text-gray-900 text-sm">
                    {item.label}
                  </span>
                  {item.subItems && item.subItems.length > 0 && (
                    <svg
                      class="w-4 h-4 text-gray-400 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  )}
                </div>
                {item.description && (
                  <p class="text-xs text-gray-600 mt-0.5 line-clamp-1">
                    {item.description}
                  </p>
                )}
              </div>
            </div>

            {/* Nested Submenu */}
            {item.subItems && item.subItems.length > 0 && (
              <div class="absolute left-full top-0 ml-1 w-72 bg-white rounded-xl shadow-xl border border-stone-100 opacity-0 invisible group-hover/item:opacity-100 group-hover/item:visible transition-all duration-200 z-50">
                <div class="py-2">
                  {item.subItems.map((subItem) => (
                    <a
                      href={subItem.href}
                      class="block px-4 py-2.5 hover:bg-stone-50 transition-colors"
                      role="menuitem"
                    >
                      <span class="font-medium text-gray-900 text-sm block">
                        {subItem.label}
                      </span>
                      {subItem.description && (
                        <span class="text-xs text-gray-600 block mt-0.5">
                          {subItem.description}
                        </span>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</div>
