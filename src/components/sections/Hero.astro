---
interface Props {
  title?: string;
  subtitle?: string;
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  imageUrl?: string;
  imageAlt?: string;
}

const whatsappNumber = "51987654321";
const whatsappMessage = encodeURIComponent(
  "¡Hola Vinílicos J&J! 👋\n\nMe gustaría obtener más información sobre sus productos y servicios.\n\n¿Podrían asesorarme?\n\nGracias.",
);

const {
  title = "Transforma tus espacios con pisos de vinilo de alta calidad",
  primaryCta = {
    text: "Ver Proyectos",
    href: "/proyectos",
  },
  secondaryCta = {
    text: "Escríbenos por WhatsApp",
    href: `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`,
  },
  imageUrl = "/hero-image.jpg",
  imageAlt = "Instalación profesional de pisos de vinilo",
} = Astro.props;
---

<section
  class="relative min-h-screen flex items-center bg-linear-to-br from-gray-50 to-stone-100"
  aria-labelledby="hero-title"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-24">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Contenido de texto -->
      <div class="max-w-2xl">
        <!-- Main Title -->
        <h1
          id="hero-title"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6"
        >
          {title}
        </h1>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={primaryCta.href}
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-amber-800 rounded-lg hover:bg-amber-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-800 transition-colors shadow-lg hover:shadow-xl"
          >
            {primaryCta.text}
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>

          <a
            href={secondaryCta.href}
            target={secondaryCta.href.startsWith("http") ? "_blank" : undefined}
            rel={secondaryCta.href.startsWith("http")
              ? "noopener noreferrer"
              : undefined}
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-gray-700 bg-white border-2 border-gray-300 rounded-lg hover:bg-gray-50 hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
          >
            {
              secondaryCta.href.includes("wa.me") && (
                <svg
                  class="w-5 h-5 mr-2"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
              )
            }
            {secondaryCta.text}
            {
              !secondaryCta.href.includes("wa.me") && (
                <svg
                  class="w-5 h-5 ml-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                  />
                </svg>
              )
            }
          </a>
        </div>
      </div>

      <!-- Imagen -->
      <div class="relative lg:h-150">
        <div
          class="relative h-full rounded-2xl overflow-hidden shadow-2xl bg-gray-200"
        >
          <!-- Placeholder para imagen -->
          <div
            class="absolute inset-0 flex items-center justify-center bg-linear-to-br from-stone-100 to-stone-200"
          >
            <svg
              class="w-32 h-32 text-stone-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </div>

          <!-- Imagen real (cuando esté disponible) -->
          <!-- <img
            src={imageUrl}
            alt={imageAlt}
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          /> -->
        </div>

        <!-- Decoración flotante -->
        <div
          class="absolute -top-6 -right-6 w-24 h-24 bg-amber-800 rounded-full opacity-20 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute -bottom-6 -left-6 w-32 h-32 bg-stone-400 rounded-full opacity-20 blur-2xl"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- Decoración de fondo -->
  <div
    class="absolute top-0 right-0 w-1/3 h-1/3 bg-amber-800 opacity-5 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-1/4 h-1/4 bg-stone-400 opacity-5 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>
</section>
