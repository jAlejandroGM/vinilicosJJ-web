---
interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  primaryCta?: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  imageUrl?: string;
  imageAlt?: string;
}

const {
  title = "Transforma tus espacios con pisos de vinilo de alta calidad",
  subtitle = "Vinílicos JJ",
  description = "Especialistas en instalación profesional de pisos de vinilo. Soluciones duraderas, elegantes y resistentes para tu hogar o negocio.",
  primaryCta = {
    text: "Ver Catálogo",
    href: "/productos",
  },
  secondaryCta = {
    text: "Contactar",
    href: "/contacto",
  },
  imageUrl = "/hero-image.jpg",
  imageAlt = "Instalación profesional de pisos de vinilo",
} = Astro.props;
---

<section
  class="relative min-h-screen flex items-center bg-linear-to-br from-gray-50 to-stone-100"
  aria-labelledby="hero-title"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-24">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Contenido de texto -->
      <div class="max-w-2xl">
        <!-- Subtitle/Brand -->
        <div class="inline-flex items-center gap-2 mb-6">
          <div class="w-12 h-1 bg-amber-800 rounded-full" aria-hidden="true">
          </div>
          <span
            class="text-sm md:text-base font-semibold text-amber-800 uppercase tracking-wider"
          >
            {subtitle}
          </span>
        </div>

        <!-- Main Title -->
        <h1
          id="hero-title"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6"
        >
          {title}
        </h1>

        <!-- Description -->
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-8">
          {description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={primaryCta.href}
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-white bg-amber-800 rounded-lg hover:bg-amber-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-800 transition-colors shadow-lg hover:shadow-xl"
          >
            {primaryCta.text}
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>

          <a
            href={secondaryCta.href}
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-gray-700 bg-white border-2 border-gray-300 rounded-lg hover:bg-gray-50 hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
          >
            {secondaryCta.text}
            <svg
              class="w-5 h-5 ml-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
          </a>
        </div>

        <!-- Features/Benefits -->
        <div class="mt-12 grid grid-cols-3 gap-6">
          <div class="text-center">
            <div
              class="text-3xl md:text-4xl font-bold text-amber-800 mb-2"
              aria-label="Más de 10 años de experiencia"
            >
              10+
            </div>
            <div class="text-sm text-gray-600">Años de experiencia</div>
          </div>
          <div class="text-center">
            <div
              class="text-3xl md:text-4xl font-bold text-amber-800 mb-2"
              aria-label="Más de 500 proyectos completados"
            >
              500+
            </div>
            <div class="text-sm text-gray-600">Proyectos completados</div>
          </div>
          <div class="text-center">
            <div
              class="text-3xl md:text-4xl font-bold text-amber-800 mb-2"
              aria-label="100% de satisfacción garantizada"
            >
              100%
            </div>
            <div class="text-sm text-gray-600">Satisfacción</div>
          </div>
        </div>
      </div>

      <!-- Imagen -->
      <div class="relative lg:h-150">
        <div
          class="relative h-full rounded-2xl overflow-hidden shadow-2xl bg-gray-200"
        >
          <!-- Placeholder para imagen -->
          <div
            class="absolute inset-0 flex items-center justify-center bg-linear-to-br from-stone-100 to-stone-200"
          >
            <svg
              class="w-32 h-32 text-stone-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </div>

          <!-- Imagen real (cuando esté disponible) -->
          <!-- <img
            src={imageUrl}
            alt={imageAlt}
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          /> -->
        </div>

        <!-- Decoración flotante -->
        <div
          class="absolute -top-6 -right-6 w-24 h-24 bg-amber-800 rounded-full opacity-20 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="absolute -bottom-6 -left-6 w-32 h-32 bg-stone-400 rounded-full opacity-20 blur-2xl"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- Decoración de fondo -->
  <div
    class="absolute top-0 right-0 w-1/3 h-1/3 bg-amber-800 opacity-5 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-1/4 h-1/4 bg-stone-400 opacity-5 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>
</section>
