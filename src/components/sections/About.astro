---
interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  additionalDescription?: string;
  features?: Feature[];
  imageUrl?: string;
  imageAlt?: string;
}

const {
  title = "Sobre Nosotros",
  subtitle = "Especialistas en instalación de pisos vinílicos a domicilio",
  description = "Vinílicos J&J es una empresa especializada en la instalación de pisos vinílicos a domicilio, enfocada en brindar un servicio práctico, moderno y de alta calidad. Contamos con un equipo de trabajo especializado que cuida cada detalle del proceso, desde la preparación del espacio hasta el acabado final, garantizando un resultado limpio, resistente y de alta calidad.",
  additionalDescription = "Nos caracterizamos por nuestra responsabilidad, puntualidad y atención personalizada, adaptándonos a las necesidades de cada cliente y ofreciendo asesoría para elegir el piso ideal según el espacio y el uso. Nuestro objetivo es transformar ambientes con materiales de calidad y un servicio confiable, logrando espacios funcionales y con un diseño que marque la diferencia.",
  features = [
    {
      icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
      title: "Calidad Garantizada",
      description:
        "Trabajamos con materiales de alta calidad y cuidamos cada detalle para asegurar pisos resistentes, duraderos y con excelente acabado.",
    },
    {
      icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
      title: "Equipo Profesional",
      description:
        "Contamos con personal capacitado y con experiencia en instalación de pisos vinílicos, garantizando un trabajo limpio y preciso.",
    },
    {
      icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
      title: "Cumplimiento y Puntualidad",
      description:
        "Respetamos los tiempos acordados y entregamos cada proyecto con responsabilidad y compromiso.",
    },
    {
      icon: "M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
      title: "Atención Personalizada",
      description:
        "Brindamos asesoría según las necesidades de cada cliente, ayudando a elegir la mejor opción para cada espacio.",
    },
  ],
  imageUrl = "/about-image.jpg",
  imageAlt = "Equipo de Vinílicos JJ",
} = Astro.props;
---

<section
  class="py-16 md:py-24 bg-linear-to-br from-amber-50 to-stone-50"
  aria-labelledby="about-title"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de sección -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <span
        class="inline-block px-4 py-2 bg-amber-800 text-white text-sm font-semibold rounded-full mb-6"
      >
        Conócenos
      </span>
      <h2
        id="about-title"
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4"
      >
        {title}
      </h2>
      <p class="text-xl text-amber-800 font-semibold mb-6">
        {subtitle}
      </p>
      <p class="text-lg text-gray-600 leading-relaxed mb-4">
        {description}
      </p>
      <p class="text-lg text-gray-600 leading-relaxed">
        {additionalDescription}
      </p>
    </div>

    <!-- Contenido principal: Grid de imagen y características -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16">
      <!-- Imagen -->
      <div class="order-2 lg:order-1">
        <div class="relative rounded-2xl overflow-hidden shadow-xl">
          <!-- Placeholder para imagen -->
          <div
            class="aspect-4/3 bg-linear-to-br from-stone-100 to-stone-200 flex items-center justify-center"
          >
            <svg
              class="w-24 h-24 text-stone-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>

          <!-- Imagen real (cuando esté disponible) -->
          <!-- <img
            src={imageUrl}
            alt={imageAlt}
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          /> -->
        </div>
      </div>

      <!-- Features Grid -->
      <div class="order-1 lg:order-2">
        <div class="grid sm:grid-cols-2 gap-6">
          {
            features.map((feature) => (
              <div class="bg-white rounded-xl p-6 shadow-md border-2 border-amber-800/10 hover:border-amber-800/30 hover:shadow-lg transition-all duration-300 group">
                <div class="w-12 h-12 bg-amber-800 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  <svg
                    class="w-6 h-6 text-white"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={feature.icon}
                    />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">
                  {feature.title}
                </h3>
                <p class="text-sm text-gray-600 leading-relaxed">
                  {feature.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
