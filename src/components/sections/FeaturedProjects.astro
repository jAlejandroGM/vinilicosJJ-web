---
import { projects } from "../../data/projects";
import ProjectModal from "../ui/ProjectModal.astro";

interface Props {
  title?: string;
  subtitle?: string;
  maxProjects?: number;
}

const {
  title = "Proyectos Recientes",
  subtitle = "Conoce algunos de nuestros trabajos más destacados",
  maxProjects = 3,
} = Astro.props;

// Obtener los últimos proyectos (ordenados por fecha de instalación más reciente)
const featuredProjects = projects
  .sort((a, b) => {
    const dateA = new Date(a.installationDates.start);
    const dateB = new Date(b.installationDates.start);
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, maxProjects);
---

<section class="py-16 md:py-24 bg-white" aria-labelledby="projects-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de sección -->
    <div class="text-center mb-12 md:mb-16">
      <h2
        id="projects-title"
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4"
      >
        {title}
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
        {subtitle}
      </p>
    </div>

    <!-- Grid de proyectos -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        featuredProjects.map((project) => (
          <article class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow group">
            {/* Imagen del proyecto */}
            <div class="relative h-64 bg-stone-200 overflow-hidden">
              <div class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent z-10" />

              {/* Placeholder de imagen */}
              <div class="absolute inset-0 flex items-center justify-center bg-linear-to-br from-stone-100 to-stone-200">
                <svg
                  class="w-20 h-20 text-stone-400"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
              </div>
            </div>

            {/* Contenido */}
            <div class="p-6">
              {/* Título */}
              <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-amber-800 transition-colors">
                {project.clientName}
              </h3>

              {/* Ubicación */}
              <div class="flex items-center gap-2 text-gray-600 mb-6">
                <svg
                  class="w-5 h-5 text-amber-800"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                <span class="text-sm">{project.location}</span>
              </div>

              {/* Botón Ver más detalles */}
              <button
                class="open-modal-btn inline-flex items-center justify-center w-full px-6 py-3 text-base font-semibold text-amber-800 bg-amber-50 rounded-lg hover:bg-amber-100 transition-colors cursor-pointer"
                data-project-id={project.id}
              >
                Ver más detalles
                <svg
                  class="w-5 h-5 ml-2"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"
                  />
                </svg>
              </button>
            </div>

            {/* Modal */}
            <ProjectModal projectId={project.id} />
          </article>
        ))
      }
    </div>

    <!-- CTA para ver más proyectos -->
    <div class="text-center mt-12">
      <a
        href="/proyectos"
        class="inline-flex items-center gap-2 px-8 py-4 bg-amber-800 text-white font-bold rounded-lg shadow-lg hover:bg-amber-900 hover:shadow-xl hover:scale-105 transition-all"
      >
        Ver Todos los Proyectos
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { projects } from "../../data/projects";

  // Handle modal opening
  document.addEventListener("DOMContentLoaded", () => {
    const openModalButtons = document.querySelectorAll(".open-modal-btn");

    openModalButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const projectId = button.getAttribute("data-project-id");
        if (!projectId) return;

        const modal = document.getElementById(`modal-${projectId}`);
        const modalContentDiv = document.getElementById(
          `modal-content-${projectId}`,
        );

        if (!modal || !modalContentDiv) return;

        // Find project data
        const project = projects.find((p) => p.id === projectId);
        if (!project) return;

        // Build modal content
        const content = `
          <!-- Left: Image Carousel -->
          <div class="relative bg-stone-100 h-full min-h-[500px] md:min-h-0">
            <div class="carousel-modal-container relative h-full">
              ${project.images
                .map(
                  (image, index) => `
                <div class="carousel-modal-slide absolute inset-0 transition-opacity duration-500 ${index === 0 ? "opacity-100" : "opacity-0"}">
                  <img
                    src="${image}"
                    alt="${project.clientName} - Imagen ${index + 1}"
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              `,
                )
                .join("")}
            </div>
            
            <!-- Indicators -->
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-10">
              ${project.images
                .map(
                  (_, index) => `
                <div class="carousel-modal-indicator w-2 h-2 rounded-full transition-all ${index === 0 ? "bg-white w-6" : "bg-white/50"}" data-index="${index}"></div>
              `,
                )
                .join("")}
            </div>
          </div>

          <!-- Right: Project Details -->
          <div class="p-6 overflow-y-auto space-y-6">
            <!-- Project Header -->
            <div>
              <h3 class="text-2xl font-bold text-gray-900 mb-2">${project.clientName}</h3>
              <div class="flex items-center gap-2 text-gray-600">
                <svg class="w-5 h-5 text-amber-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>${project.location}</span>
              </div>
            </div>

            <!-- Description -->
            <div>
              <h4 class="text-lg font-semibold text-gray-900 mb-2">Descripción del Proyecto</h4>
              <p class="text-gray-700 leading-relaxed">${project.description}</p>
            </div>

            <!-- Project Details -->
            <div class="grid gap-4">
              ${
                project.area
                  ? `
              <div class="bg-stone-50 rounded-lg p-4">
                <div class="flex items-center gap-2 text-sm text-gray-600 mb-1">
                  <svg class="w-5 h-5 text-amber-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5" />
                  </svg>
                  <span class="font-semibold">Área instalada</span>
                </div>
                <p class="text-2xl font-bold text-gray-900">${project.area}</p>
              </div>
              `
                  : ""
              }
              
              <div class="bg-stone-50 rounded-lg p-4">
                <div class="flex items-center gap-2 text-sm text-gray-600 mb-1">
                  <svg class="w-5 h-5 text-amber-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="font-semibold">Fecha de instalación</span>
                </div>
                <p class="text-lg font-bold text-gray-900">
                  ${new Date(project.installationDates.start).toLocaleDateString("es-PE", { month: "long", year: "numeric" })}
                  ${project.installationDates.end ? ` - ${new Date(project.installationDates.end).toLocaleDateString("es-PE", { month: "long", year: "numeric" })}` : ""}
                </p>
              </div>
            </div>

            <!-- Services -->
            <div>
              <h4 class="text-lg font-semibold text-gray-900 mb-3">Servicios Realizados</h4>
              <div class="flex flex-wrap gap-2">
                ${project.services
                  .map(
                    (service) => `
                  <span class="inline-block px-3 py-1.5 bg-amber-50 text-amber-800 text-sm font-medium rounded-lg border border-amber-200">
                    ${service}
                  </span>
                `,
                  )
                  .join("")}
              </div>
            </div>

            <!-- Products -->
            <div>
              <h4 class="text-lg font-semibold text-gray-900 mb-3">Materiales Utilizados</h4>
              <ul class="space-y-2">
                ${project.products
                  .map(
                    (product) => `
                  <li class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-amber-800 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="text-gray-700">${product}</span>
                  </li>
                `,
                  )
                  .join("")}
              </ul>
            </div>
          </div>
        `;

        // Insert content
        modalContentDiv.innerHTML = content;

        // Initialize carousel
        initModalCarousel(projectId, project.images.length);

        // Show modal
        document.body.style.overflow = "hidden";
        modal.classList.remove("hidden");
        setTimeout(() => {
          modal.classList.remove("opacity-0");
          modal.classList.add("opacity-100");
          const modalContent = modal.querySelector(".modal-content");
          if (modalContent) {
            modalContent.classList.remove("scale-95");
            modalContent.classList.add("scale-100");
          }
        }, 10);
      });
    });
  });

  // Function to initialize modal carousel
  function initModalCarousel(projectId: any, totalImages: any) {
    if (totalImages <= 1) return;

    const modal = document.getElementById(`modal-${projectId}`);
    if (!modal) return;

    const slides = modal.querySelectorAll(".carousel-modal-slide");
    const indicators = modal.querySelectorAll(".carousel-modal-indicator");
    let currentSlide = 0;
    let carouselInterval: any;

    function showSlide(index: any) {
      slides.forEach((slide, i) => {
        slide.classList.toggle("opacity-100", i === index);
        slide.classList.toggle("opacity-0", i !== index);
      });

      indicators.forEach((indicator, i) => {
        if (i === index) {
          indicator.classList.add("bg-white", "w-6");
          indicator.classList.remove("bg-white/50");
        } else {
          indicator.classList.remove("bg-white", "w-6");
          indicator.classList.add("bg-white/50");
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalImages;
      showSlide(currentSlide);
    }

    // Auto-advance carousel every 3 seconds
    carouselInterval = setInterval(nextSlide, 3000);

    // Clear interval when modal is closed
    const closeBtn = modal.querySelector(".modal-close");
    const backdrop = modal;

    function clearCarousel() {
      if (carouselInterval) {
        clearInterval(carouselInterval);
      }
    }

    closeBtn?.addEventListener("click", clearCarousel, { once: true });
    backdrop?.addEventListener(
      "click",
      (e) => {
        if (e.target === backdrop) {
          clearCarousel();
        }
      },
      { once: true },
    );
  }
</script>
