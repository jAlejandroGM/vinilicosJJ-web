---
const currentYear = new Date().getFullYear();

const navigation = {
  productos: [
    { name: "Pisos SPC", href: "/productos/spc" },
    { name: "Pisos WPC", href: "/productos/wpc" },
    { name: "Pisos LVT", href: "/productos/lvt" },
    { name: "Accesorios", href: "/productos/accesorios" },
  ],
  servicios: [
    { name: "Instalación Profesional", href: "/servicios/instalacion" },
    { name: "Asesoría", href: "/servicios/asesoria" },
    { name: "Mantenimiento", href: "/servicios/mantenimiento" },
    { name: "Garantía", href: "/servicios/garantia" },
  ],
  empresa: [
    { name: "Sobre Nosotros", href: "/nosotros" },
    { name: "Galería", href: "/galeria" },
    { name: "Blog", href: "/blog" },
    { name: "Contacto", href: "/contacto" },
  ],
};

const contactInfo = [
  {
    icon: "phone",
    label: "Teléfono",
    value: "+52 123 456 7890",
    href: "tel:+521234567890",
  },
  {
    icon: "email",
    label: "Email",
    value: "contacto@vinilicosjj.com",
    href: "mailto:contacto@vinilicosjj.com",
  },
  {
    icon: "location",
    label: "Ubicación",
    value: "Ciudad de México, México",
    href: "#",
  },
];

const socialLinks = [
  {
    name: "Facebook",
    href: "https://facebook.com",
    icon: "M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z",
  },
  {
    name: "Instagram",
    href: "https://instagram.com",
    icon: "M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01m5.49 4.5a7 7 0 11-14 0 7 7 0 0114 0z",
  },
  {
    name: "WhatsApp",
    href: "https://wa.me/521234567890",
    icon: "M17 8l-10 10m0-10l10 10m-5-13a9 9 0 100 18 9 9 0 000-18z",
  },
];
---

<footer class="bg-stone-900 text-stone-300">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Información de la Empresa -->
      <div class="lg:col-span-1">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xl font-bold text-white hover:text-amber-200 transition-colors mb-4"
          aria-label="Vinílicos JJ - Ir a inicio"
        >
          <svg
            class="w-8 h-8"
            viewBox="0 0 40 40"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect width="40" height="40" rx="8" fill="#92400E"></rect>
            <path
              d="M10 15L20 25L30 15"
              stroke="white"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M10 25H30"
              stroke="white"
              stroke-width="3"
              stroke-linecap="round"></path>
          </svg>
          <span>Vinílicos JJ</span>
        </a>
        <p class="text-sm leading-relaxed mb-6">
          Especialistas en pisos de vinilo de alta calidad. Transformamos
          espacios con soluciones duraderas y elegantes.
        </p>

        <!-- Redes Sociales -->
        <div class="flex gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-10 h-10 flex items-center justify-center rounded-lg bg-stone-800 text-stone-400 hover:bg-amber-800 hover:text-white transition-colors"
                aria-label={`Visitar ${social.name}`}
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={social.icon}
                  />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Productos -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Productos</h3>
        <ul class="space-y-3" role="list">
          {
            navigation.productos.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm hover:text-white hover:underline transition-colors"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Servicios</h3>
        <ul class="space-y-3" role="list">
          {
            navigation.servicios.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm hover:text-white hover:underline transition-colors"
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-white font-semibold text-lg mb-4">Contacto</h3>
        <ul class="space-y-4" role="list">
          {
            contactInfo.map((contact) => (
              <li>
                <a
                  href={contact.href}
                  class="flex items-start gap-3 text-sm hover:text-white transition-colors group"
                >
                  <svg
                    class="w-5 h-5 text-amber-600 group-hover:text-amber-500 shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    {contact.icon === "phone" && (
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                      />
                    )}
                    {contact.icon === "email" && (
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                      />
                    )}
                    {contact.icon === "location" && (
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                      />
                    )}
                  </svg>
                  <div>
                    <span class="block text-xs text-gray-400">
                      {contact.label}
                    </span>
                    <span class="block">{contact.value}</span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Línea divisoria -->
    <div class="border-t border-stone-800 mt-12 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-stone-400">
          &copy; {currentYear} Vinílicos JJ. Todos los derechos reservados.
        </p>
        <div class="flex gap-6">
          <a
            href="/privacidad"
            class="text-sm text-stone-400 hover:text-white transition-colors"
          >
            Política de Privacidad
          </a>
          <a
            href="/terminos"
            class="text-sm text-stone-400 hover:text-white transition-colors"
          >
            Términos de Uso
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
