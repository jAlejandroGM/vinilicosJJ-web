---
import ContactItem from "../ui/ContactItem.astro";

const currentYear = new Date().getFullYear();

const contactInfo = [
  {
    icon: "phone",
    label: "Teléfono",
    value: "+51 961 736 855",
    href: "tel:+51987654321",
  },
  {
    icon: "location",
    label: "Ubicación",
    value: "Alejandro Mendoza con Calle 25, Los Olivos, Lima, Perú",
    href: "#",
  },
  {
    icon: "email",
    label: "Email",
    value: "vinilicojj@gmail.com",
    href: "mailto:vinilicojj@gmail.com",
  },
  {
    icon: "clock",
    label: "Horario de Atención",
    value: "Lun - Sáb: 9:00 AM - 6:00 PM",
    href: "#",
  },
] as const;

const socialLinks = [
  {
    name: "Facebook",
    href: "https://facebook.com",
    icon: "M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z",
  },
  {
    name: "TikTok",
    href: "https://tiktok.com",
    icon: "M9 12a4 4 0 1 0 4 4V6a5 5 0 0 0 5 5",
  },
];
---

<footer class="bg-stone-900 text-stone-300">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Logo y Eslogan -->
      <div class="lg:col-span-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xl font-bold text-white hover:text-amber-200 transition-colors mb-4"
          aria-label="Vinílicos JJ - Ir a inicio"
        >
          <svg
            class="w-8 h-8"
            viewBox="0 0 40 40"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect width="40" height="40" rx="8" fill="#92400E"></rect>
            <path
              d="M10 15L20 25L30 15"
              stroke="white"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M10 25H30"
              stroke="white"
              stroke-width="3"
              stroke-linecap="round"></path>
          </svg>
          <span>Vinílicos JJ</span>
        </a>
        <p class="text-sm leading-relaxed text-stone-400 mb-8">
          Especialistas en pisos de vinilo de alta calidad. Transformamos
          espacios con soluciones duraderas y elegantes.
        </p>

        <!-- Libro de Reclamaciones -->
        <a
          href="#libro-reclamaciones"
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-stone-800 hover:bg-amber-800 text-stone-300 hover:text-white rounded-lg transition-all group"
        >
          <svg
            class="w-5 h-5 text-amber-600 group-hover:text-white transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
          <span class="text-sm font-semibold">Libro de Reclamaciones</span>
        </a>
      </div>

      <!-- Información de Contacto -->
      <div class="lg:col-span-5" id="contacto">
        <h3 class="text-white font-bold text-lg mb-6">Contáctanos</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            contactInfo.map((contact) => (
              <ContactItem
                icon={contact.icon}
                label={contact.label}
                value={contact.value}
                href={contact.href}
              />
            ))
          }
        </div>
      </div>

      <!-- Redes Sociales -->
      <div class="lg:col-span-3">
        <h3 class="text-white font-bold text-lg mb-6">Síguenos</h3>
        <div class="flex gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 flex items-center justify-center rounded-lg bg-stone-800 text-stone-400 hover:bg-amber-800 hover:text-white hover:scale-110 transition-all shadow-lg hover:shadow-amber-800/50"
                aria-label={`Visitar ${social.name}`}
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={social.icon}
                  />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-stone-800 mt-12 pt-8">
      <p class="text-sm text-stone-400 text-center">
        &copy; {currentYear} Vinílicos JJ. Todos los derechos reservados.
      </p>
      <p class="text-xs text-stone-500 text-center mt-2">
        Desarrollado por <a
          href="https://alguzdev.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-amber-800 hover:text-amber-700 transition-colors font-medium"
        >
          alguzdev
        </a>
      </p>
    </div>
  </div>
</footer>
