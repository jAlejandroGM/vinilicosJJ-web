---
import DropdownMenu from "../ui/DropdownMenu.astro";
import { getProductNavigation } from "../../data/products";

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/servicios", label: "Servicios" },
  { href: "/proyectos", label: "Proyectos" },
];

const currentPath = Astro.url.pathname;

// Obtener navegación de productos
const productNavItems = getProductNavigation();

// Preparar items del dropdown con iconos SVG
const dropdownItems = productNavItems.map((item) => ({
  ...item,
  icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
}));

// Verificar si la ruta actual es de productos
const isProductsActive = currentPath.startsWith("/productos");
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-md">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 text-xl md:text-2xl font-bold text-gray-900 hover:text-amber-800 transition-colors"
        aria-label="Vinílicos JJ - Ir a inicio"
      >
        <svg
          class="w-8 h-8 md:w-10 md:h-10"
          viewBox="0 0 40 40"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect width="40" height="40" rx="8" fill="#92400E"></rect>
          <path
            d="M10 15L20 25L30 15"
            stroke="white"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M10 25H30"
            stroke="white"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
        <span>Vinílicos JJ</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1 flex-1 justify-end">
        <nav class="flex items-center gap-1" aria-label="Navegación principal">
          {
            navLinks.slice(0, 2).map(({ href, label }) => {
              const isActive = currentPath === href;
              return (
                <a
                  href={href}
                  class={`px-4 py-2 rounded-lg font-medium transition-colors ${
                    isActive
                      ? "bg-amber-800 text-white"
                      : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
                  }`}
                  aria-current={isActive ? "page" : undefined}
                >
                  {label}
                </a>
              );
            })
          }

          <!-- Link Productos con Dropdown -->
          <div class="relative group">
            <a
              href="/productos"
              class={`inline-flex items-center gap-1 px-4 py-2 rounded-lg font-medium transition-colors ${
                currentPath === "/productos" ||
                currentPath.startsWith("/productos/")
                  ? "bg-amber-800 text-white"
                  : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
              }`}
              aria-current={currentPath === "/productos" ? "page" : undefined}
            >
              Productos
              <svg
                class="w-4 h-4 transition-transform group-hover:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </a>

            <!-- Dropdown Menu -->
            <div
              class="absolute top-full left-0 mt-2 w-80 bg-white rounded-xl shadow-xl border border-stone-100 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
              role="menu"
              aria-orientation="vertical"
            >
              <div class="py-2">
                {
                  productNavItems.map((category) => (
                    <div class="relative group/item">
                      {/* Category Item */}
                      <div class="flex items-start gap-3 px-4 py-3 hover:bg-stone-50 transition-colors cursor-default">
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center justify-between">
                            <span class="font-semibold text-gray-900 text-sm">
                              {category.label}
                            </span>
                            {category.subItems &&
                              category.subItems.length > 0 && (
                                <svg
                                  class="w-4 h-4 text-gray-400 shrink-0"
                                  fill="none"
                                  viewBox="0 0 24 24"
                                  stroke="currentColor"
                                  aria-hidden="true"
                                >
                                  <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"
                                  />
                                </svg>
                              )}
                          </div>
                          {category.description && (
                            <p class="text-xs text-gray-600 mt-0.5 line-clamp-1">
                              {category.description}
                            </p>
                          )}
                        </div>
                      </div>

                      {/* Nested Submenu */}
                      {category.subItems && category.subItems.length > 0 && (
                        <div class="absolute right-full top-0 mr-1 w-72 bg-white rounded-xl shadow-xl border border-stone-100 opacity-0 invisible group-hover/item:opacity-100 group-hover/item:visible transition-all duration-200 z-50">
                          <div class="py-2">
                            {category.subItems.map((subItem) => (
                              <a
                                href={subItem.href}
                                class="block px-4 py-2.5 hover:bg-stone-50 transition-colors"
                                role="menuitem"
                              >
                                <span class="font-medium text-gray-900 text-sm block">
                                  {subItem.label}
                                </span>
                                {subItem.description && (
                                  <span class="text-xs text-gray-600 block mt-0.5">
                                    {subItem.description}
                                  </span>
                                )}
                              </a>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          {
            navLinks.slice(2).map(({ href, label }) => {
              const isActive =
                currentPath === href ||
                (href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  class={`px-4 py-2 rounded-lg font-medium transition-colors ${
                    isActive
                      ? "bg-amber-800 text-white"
                      : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
                  }`}
                  aria-current={isActive ? "page" : undefined}
                >
                  {label}
                </a>
              );
            })
          }
        </nav>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-gray-700 hover:bg-gray-100 hover:text-amber-800 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-amber-800 transition-colors"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
      >
        <svg
          id="menu-icon"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-4"
      aria-label="Navegación móvil"
    >
      <div class="flex flex-col gap-2">
        <!-- Inicio y Nosotros -->
        {
          navLinks.slice(0, 2).map(({ href, label }) => {
            const isActive = currentPath === href;
            return (
              <a
                href={href}
                class={`px-4 py-3 rounded-lg font-medium transition-colors ${
                  isActive
                    ? "bg-amber-800 text-white"
                    : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
                }`}
                aria-current={isActive ? "page" : undefined}
              >
                {label}
              </a>
            );
          })
        }

        <!-- Productos (Mobile) -->
        <div class="border-t border-stone-100 pt-2">
          <!-- Link directo a /productos -->}
          <a
            href="/productos"
            class={`block px-4 py-3 rounded-lg font-medium transition-colors ${
              currentPath === "/productos"
                ? "bg-amber-800 text-white"
                : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
            }`}
            aria-current={currentPath === "/productos" ? "page" : undefined}
          >
            Productos
          </a>

          <!-- Toggle para Categorías -->
          <button
            type="button"
            id="mobile-productos-toggle"
            class="w-full flex items-center justify-between px-4 py-3 rounded-lg font-medium transition-colors text-gray-700 hover:bg-gray-100 hover:text-amber-800 text-sm"
            aria-expanded="false"
            aria-controls="mobile-productos-menu"
          >
            <span>Ver categorías</span>
            <svg
              class="w-5 h-5 transition-transform"
              id="mobile-productos-icon"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <div
            id="mobile-productos-menu"
            class="hidden pl-4 mt-2 space-y-2"
            role="region"
            aria-labelledby="mobile-productos-toggle"
          >
            {
              productNavItems.map((category) => (
                <div class="space-y-1">
                  <a
                    href={category.href}
                    class="block px-4 py-2 text-sm font-medium text-gray-700 hover:bg-stone-50 hover:text-amber-800 rounded-lg transition-colors"
                  >
                    {category.label}
                  </a>
                  {category.subItems && category.subItems.length > 0 && (
                    <div class="pl-4 space-y-1">
                      {category.subItems.map((subItem) => (
                        <a
                          href={subItem.href}
                          class="block px-4 py-2 text-xs text-gray-600 hover:bg-stone-50 hover:text-amber-800 rounded-lg transition-colors"
                        >
                          {subItem.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Otros Links -->
        {
          navLinks.slice(2).map(({ href, label }) => {
            const isActive =
              currentPath === href ||
              (href !== "/" && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class={`px-4 py-3 rounded-lg font-medium transition-colors ${
                  isActive
                    ? "bg-amber-800 text-white"
                    : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
                }`}
                aria-current={isActive ? "page" : undefined}
              >
                {label}
              </a>
            );
          })
        }
      </div>
    </nav>
  </div>
</header>

<!-- Spacer para compensar el header fixed -->
<div class="h-16 md:h-20" aria-hidden="true"></div>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");
  const productosToggle = document.getElementById("mobile-productos-toggle");
  const productosMenu = document.getElementById("mobile-productos-menu");
  const productosIcon = document.getElementById("mobile-productos-icon");

  // Toggle menú móvil principal
  if (button && menu && menuIcon && closeIcon) {
    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";

      button.setAttribute("aria-expanded", String(!isExpanded));
      button.setAttribute(
        "aria-label",
        isExpanded ? "Abrir menú de navegación" : "Cerrar menú de navegación",
      );

      menu.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });

    // Cerrar menú al hacer clic en un enlace (pero no en el toggle de productos)
    const mobileLinks = menu.querySelectorAll("a");
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Abrir menú de navegación");
        menu.classList.add("hidden");
        menuIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      });
    });
  }

  // Toggle submenu de productos en móvil
  if (productosToggle && productosMenu && productosIcon) {
    productosToggle.addEventListener("click", () => {
      const isExpanded =
        productosToggle.getAttribute("aria-expanded") === "true";

      productosToggle.setAttribute("aria-expanded", String(!isExpanded));
      productosMenu.classList.toggle("hidden");
      productosIcon.style.transform = isExpanded
        ? "rotate(0deg)"
        : "rotate(180deg)";
    });
  }
</script>
