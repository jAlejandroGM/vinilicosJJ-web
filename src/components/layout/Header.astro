---
const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/productos", label: "Productos" },
  { href: "/servicios", label: "Servicios" },
  { href: "/galeria", label: "Galería" },
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white shadow-md">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 text-xl md:text-2xl font-bold text-gray-900 hover:text-amber-800 transition-colors"
        aria-label="Vinílicos JJ - Ir a inicio"
      >
        <svg
          class="w-8 h-8 md:w-10 md:h-10"
          viewBox="0 0 40 40"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect width="40" height="40" rx="8" fill="#92400E"></rect>
          <path
            d="M10 15L20 25L30 15"
            stroke="white"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M10 25H30"
            stroke="white"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
        <span>Vinílicos JJ</span>
      </a>

      <!-- Desktop Navigation -->
      <nav
        class="hidden md:flex items-center gap-1"
        aria-label="Navegación principal"
      >
        {
          navLinks.map(({ href, label }) => {
            const isActive =
              currentPath === href ||
              (href !== "/" && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class={`px-4 py-2 rounded-lg font-medium transition-colors ${
                  isActive
                    ? "bg-amber-800 text-white"
                    : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
                }`}
                aria-current={isActive ? "page" : undefined}
              >
                {label}
              </a>
            );
          })
        }
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-gray-700 hover:bg-gray-100 hover:text-amber-800 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-amber-800 transition-colors"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
      >
        <svg
          id="menu-icon"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-4"
      aria-label="Navegación móvil"
    >
      <div class="flex flex-col gap-2">
        {
          navLinks.map(({ href, label }) => {
            const isActive =
              currentPath === href ||
              (href !== "/" && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class={`px-4 py-3 rounded-lg font-medium transition-colors ${
                  isActive
                    ? "bg-amber-800 text-white"
                    : "text-gray-700 hover:bg-gray-100 hover:text-amber-800"
                }`}
                aria-current={isActive ? "page" : undefined}
              >
                {label}
              </a>
            );
          })
        }
      </div>
    </nav>
  </div>
</header>

<!-- Spacer para compensar el header fixed -->
<div class="h-16 md:h-20" aria-hidden="true"></div>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  if (button && menu && menuIcon && closeIcon) {
    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";

      button.setAttribute("aria-expanded", String(!isExpanded));
      button.setAttribute(
        "aria-label",
        isExpanded ? "Abrir menú de navegación" : "Cerrar menú de navegación",
      );

      menu.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });

    // Cerrar menú al hacer clic en un enlace
    const mobileLinks = menu.querySelectorAll("a");
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Abrir menú de navegación");
        menu.classList.add("hidden");
        menuIcon.classList.remove("hidden");
        closeIcon.classList.add("hidden");
      });
    });
  }
</script>
